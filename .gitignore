# Dependencies
node_modules/

# Framework and build output
.next/
.vinext/
/dist/

# Local Cloudflare runtime state
.wrangler/state/

# TypeScript incremental build metadata
*.tsbuildinfo

# Local environment files
.env*
!.env.example

# Wrangler local secrets (e.g. ANTHROPIC_API_KEY for the AI indicator analysis route)
.dev.vars*
!.dev.vars.example

# Backfilled calibration history (large, regenerable; see scripts/backfill-*.mjs)
data/calibration/

# 含服务器凭据的明文文件，绝不可提交（建议移出仓库目录）
YY.txt

# 持仓/多空比历史：大，且【不可重新生成】（币安 /futures/data/ 只保留 30 天）。
# 以部署服务器为存放地，由用户定期收集备份。git 不适合只增不减的序列数据。
data/indicators/positions/

# 导出给用户下载的数据包（由 scripts/serve-export.mjs 提供下载）
data/export/

# 预测留档：不可重新生成（记的是"当时"的排名，事后无法补），以部署服务器为存放地
data/predictions/

# 一键采集脚本每次运行的报告，纯本地状态
data/collect-all-last-report.json

# 从服务器拷回的数据副本（体积大，只在本地使用，不进 git）
CypeData/
